<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cross Browser Parallel Suite" parallel="tests" thread-count="3">

	<listeners>

		<listener
			class-name="com.saucedemo.listeners.TestListener" />
	</listeners>

	<!-- Thread 1: Google Chrome Execution -->
	<test name="ChromeTest">
		<parameter name="browser" value="chrome" />
		<classes>
			
			<class name="com.saucedemo.tests.LoginTest" />
		</classes>
	</test>

	<!-- Thread 2: Mozilla Firefox Execution -->
	<test name="FirefoxTest">
		<parameter name="browser" value="firefox" />
		<classes>
			<class name="com.saucedemo.tests.LoginTest" />
		</classes>
	</test>

	<!-- Thread 3: Microsoft Edge Execution -->
	<test name="EdgeTest">
		<parameter name="browser" value="edge" />
		<classes>
			<class name="com.saucedemo.tests.LoginTest" />
		</classes>
	</test>

</suite> 
